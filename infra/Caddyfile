{
	servers {
		protocols h1 h2 h3

		# Cloudflare 橙云代理下才有意义：没有这两行，access.log 里的 remote_ip
		# 全是 CF 边缘节点的地址，真实访客 IP 丢失。static 列表来自
		# https://www.cloudflare.com/ips-v4 + ips-v6（2026-09-06 拉取）。
		# 官方 apt 版 Caddy 只有 http.ip_sources.static，没有动态 cloudflare 源，
		# 所以 CF 增减网段时需要手动更新这里。
		trusted_proxies static \
			173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 \
			141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 \
			197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 \
			104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 \
			2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 \
			2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP
	}
}

grace.tr www.grace.tr cn.grace.tr {
    root * /var/www/grace
    log {
        output file /var/log/caddy/access.log {
            roll_size 50MiB
            roll_keep 5
            roll_keep_for 720h
        }
        format json
    }
    file_server {
        # 优先提供预压缩文件（.br / .gz），否则 on-the-fly 压缩
        precompressed br gzip zstd
    }
    # Retired with the 2026-06-27 Turkey repositioning. Server-side 301 so crawlers and
    # cold hits get a real redirect — the client-side <Navigate> only covers in-app nav.
    redir /china-inbound /tours 301
    redir /china-inbound/* /tours 301

    # `=404` replaces the old `/index.html` SPA fallback. Every real route is a physical
    # dist/<route>/index.html, enforced at build time by scripts/apply-prerender.mjs
    # against lib/routes.manifest.mjs — so anything missing here genuinely does not exist.
    # This kills the soft-404s and takes /style-guide offline with them.
    try_files {path} {path}/index.html =404

    # Gzip + Zstd 动态压缩（Brotli 需 xcaddy 编译，defer 到后续）
    encode {
        zstd
        gzip 6
    }

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options    "nosniff"
        X-Frame-Options           "SAMEORIGIN"
        Referrer-Policy           "strict-origin-when-cross-origin"
        Permissions-Policy        "camera=(), microphone=(), geolocation=()"
        # 2026-09-26: report-only first — see grace.tr repo infra/README.md before switching to enforce.
        # cloudflareinsights = Cloudflare Web Analytics, injected at the edge (on since ~2026-09-22).
        Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://*.basemaps.cartocdn.com https://res.klook.com https://cdn.kulturenvanteri.com https://cdn.istanbul.com https://picsum.photos; connect-src 'self' https://cloudflareinsights.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"
        -Server
        ?Cache-Control "no-cache, must-revalidate"
    }

    # cn.grace.tr = 给中国大陆访客的灰云直连入口（2026-09-06 加）。
    # 背景：grace.tr / www.grace.tr 已切 Cloudflare 橙云代理，但 CF 免费版不接入
    # 大陆网络，大陆访客会被 anycast 甩到境外 PoP，质量不可控；而源站是腾讯云香港，
    # 对大陆本来就是最优直连路径之一。所以给微信服务号等自投链接留一个不经过 CF 的入口。
    # 日志统计（全量 access.log）：大陆真人请求占 5.36%，445 个独立 IP。
    #
    # 内容与主站完全相同，所以必须 noindex —— 否则和 grace.tr 构成重复内容，
    # 会稀释主站排名。如果哪天想吃百度/搜狗的自然流量，把这条去掉并给主站加
    # canonical 再说，别只删这行。
    @cn host cn.grace.tr
    header @cn X-Robots-Tag "noindex, nofollow"

    @assets {
        path /assets/* /img/* /favicon.* /site.webmanifest
    }
    header @assets {
        Cache-Control "public, max-age=31536000, immutable"
        defer
    }

    @media {
        path *.svg *.png *.jpg *.jpeg *.webp *.ico *.woff *.woff2
    }
    header @media {
        Access-Control-Allow-Origin "*"
        defer
    }

    # Serve the branded static 404 page while preserving the 404 status. A small static
    # page on purpose: a garbage URL should not pull down the 617 KB SPA bundle.
    handle_errors {
        # handle_errors is a SEPARATE route tree — the site-level `header` block above does
        # NOT apply to it. Verified: error responses came back with no HSTS / X-Frame-Options
        # / nosniff at all until these were repeated here.
        header {
            Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
            X-Content-Type-Options    "nosniff"
            X-Frame-Options           "SAMEORIGIN"
            Referrer-Policy           "strict-origin-when-cross-origin"
            Permissions-Policy        "camera=(), microphone=(), geolocation=()"
            # 2026-09-26: report-only first — see grace.tr repo infra/README.md before switching to enforce.
            Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://*.basemaps.cartocdn.com https://res.klook.com https://cdn.kulturenvanteri.com https://cdn.istanbul.com https://picsum.photos; connect-src 'self' https://cloudflareinsights.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"
            -Server
        }
        @404 expression {err.status_code} == 404
        handle @404 {
            rewrite * /404.html
            file_server {
                status 404
            }
        }
    }
}

# gracetravel.com.tr → Odoo 18 (docker, 127.0.0.1:8077 http / 8078 websocket). Live since 2026-07-10.
# Rollback: restore the redir block from Caddyfile.bak.* and reload.
gracetravel.com.tr {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "SAMEORIGIN"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}
	@websocket path /websocket /websocket/*
	reverse_proxy @websocket 127.0.0.1:8078
	reverse_proxy 127.0.0.1:8077
}

www.gracetravel.com.tr {
	redir https://gracetravel.com.tr{uri} 308
}
